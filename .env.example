# Copy to .env and set the values. .env is not committed and is not copied into the image.

# password of the first user "admin" (at least 12 characters). Used once, when there are no users.
ORVANTA_ADMIN_PASSWORD=

# secret that signs session tokens; any long random text. The same for every Orvanta process.
ORVANTA_JWT_SECRET=

# password of the RabbitMQ user "orvanta". Letters and digits only, because it is used inside a URI.
RABBITMQ_PASSWORD=

# password of the MongoDB user "orvanta" (set on the first start of an empty volume). Letters and digits only.
MONGO_PASSWORD=

# optional: port of the console on this machine (default 8480)
# ORVANTA_PORT=8480

# optional: false switches the simulated external systems off (default true in this compose file)
# ORVANTA_SIMULATOR_ENABLED=true

# IBM MQ at SBG: on when true; the connection details are in the channel models (channels.SbgMqInbound, SbgMqStatusOutbound)
# ORVANTA_SBG_MQ_ENABLED=false
# SBG_MQ_PASSWORD=
# SBG_MQ_OUT_QUEUE=
